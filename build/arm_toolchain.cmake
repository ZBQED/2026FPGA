set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7-a)
set(CMAKE_OBJECT_PATH_MAX 200)
if(NOT DEFINED ENV{MGD_VITIS_ROOT} OR NOT DEFINED ENV{MGD_ARM_SYSROOT})
  message(FATAL_ERROR "Invoke this toolchain through build/reproduce.py")
endif()
file(TO_CMAKE_PATH "$ENV{MGD_VITIS_ROOT}" VITIS)
file(TO_CMAKE_PATH "$ENV{MGD_ARM_SYSROOT}" SDK)
set(TOOLS "${VITIS}/gnu/aarch32/nt/gcc-arm-linux-gnueabi/bin")
set(CMAKE_C_COMPILER "${TOOLS}/arm-linux-gnueabihf-gcc.exe")
set(CMAKE_CXX_COMPILER "${TOOLS}/arm-linux-gnueabihf-g++.exe")
set(CMAKE_AR "${TOOLS}/arm-linux-gnueabihf-ar.exe")
set(CMAKE_RANLIB "${TOOLS}/arm-linux-gnueabihf-ranlib.exe")
set(CMAKE_SYSROOT "${SDK}")
execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-file-name=include OUTPUT_VARIABLE GCC_INCLUDE OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-file-name=libgcc.a OUTPUT_VARIABLE GCC_ARCHIVE OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-sysroot OUTPUT_VARIABLE VENDOR_SYSROOT OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
file(TO_CMAKE_PATH "${GCC_INCLUDE}" GCC_INCLUDE)
file(TO_CMAKE_PATH "${VENDOR_SYSROOT}" VENDOR_SYSROOT)
get_filename_component(GCC_LIB "${GCC_ARCHIVE}" DIRECTORY)
set(CRT "${SDK}/usr/lib/arm-linux-gnueabihf")
set(CPP "${SDK}/usr/arm-linux-gnueabihf/include/c++/9")
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a9 -mfpu=neon -mfloat-abi=hard -marm -ffp-contract=off -B${CRT}/ -B${GCC_LIB}/ -nostdinc -isystem ${GCC_INCLUDE} -isystem ${SDK}/usr/include -isystem ${SDK}/usr/include/arm-linux-gnueabihf -isystem ${VENDOR_SYSROOT}/usr/include")
set(CMAKE_CXX_FLAGS_INIT "-mcpu=cortex-a9 -mfpu=neon -mfloat-abi=hard -marm -ffp-contract=off -B${CRT}/ -B${GCC_LIB}/ -nostdinc -nostdinc++ -isystem ${CPP} -isystem ${CPP}/arm-linux-gnueabihf -isystem ${CPP}/backward -isystem ${GCC_INCLUDE} -isystem ${SDK}/usr/include -isystem ${SDK}/usr/include/arm-linux-gnueabihf -isystem ${VENDOR_SYSROOT}/usr/include -include limits")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${SDK}/usr/lib -L${GCC_LIB} -Wl,--sysroot=${SDK} -Wl,-rpath-link,${SDK}/lib")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
set(CMAKE_FIND_ROOT_PATH "${SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

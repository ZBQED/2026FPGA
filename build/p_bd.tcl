    CONFIG.C_ALL_OUTPUTS {1} \
    CONFIG.C_DOUT_DEFAULT {0x00000001} \
    CONFIG.C_GPIO_WIDTH {1} \
  ] $hand_reset


  # Create instance: hand_reset_and, and set properties
  set hand_reset_and [ create_bd_cell -type ip -vlnv xilinx.com:ip:util_vector_logic:2.0 hand_reset_and ]
  set_property -dict [list \
    CONFIG.C_OPERATION {and} \
    CONFIG.C_SIZE {1} \
  ] $hand_reset_and


  # Create instance: one, and set properties
  set one [ create_bd_cell -type ip -vlnv xilinx.com:ip:xlconstant:1.1 one ]
  set_property -dict [list \
    CONFIG.CONST_VAL {1} \
    CONFIG.CONST_WIDTH {1} \
  ] $one


  # Create instance: rst100, and set properties
  set rst100 [ create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 rst100 ]

  # Create instance: rst100hand, and set properties
  set rst100hand [ create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 rst100hand ]

  # Create interface connections
  connect_bd_intf_net -intf_net ctrl_M00_AXI [get_bd_intf_pins ctrl/M00_AXI] [get_bd_intf_pins audio_codec_ctrl_0/S_AXI]
  connect_bd_intf_net -intf_net hand_i8_m_axi_gmem [get_bd_intf_pins hand_i8/m_axi_gmem] [get_bd_intf_pins mem/S00_AXI]
  connect_bd_intf_net -intf_net hctrl_M00_AXI [get_bd_intf_pins hctrl/M00_AXI] [get_bd_intf_pins hand_reset/S_AXI]
  connect_bd_intf_net -intf_net hctrl_M01_AXI [get_bd_intf_pins hctrl/M01_AXI] [get_bd_intf_pins hand_i8/s_axi_control]
  connect_bd_intf_net -intf_net mem_M00_AXI [get_bd_intf_pins mem/M00_AXI] [get_bd_intf_pins ps7_0/S_AXI_HP1]
  connect_bd_intf_net -intf_net ps7_0_DDR [get_bd_intf_ports DDR] [get_bd_intf_pins ps7_0/DDR]
  connect_bd_intf_net -intf_net ps7_0_FIXED_IO [get_bd_intf_ports FIXED_IO] [get_bd_intf_pins ps7_0/FIXED_IO]
  connect_bd_intf_net -intf_net ps7_0_IIC_1 [get_bd_intf_ports IIC_1] [get_bd_intf_pins ps7_0/IIC_1]
  connect_bd_intf_net -intf_net ps7_0_M_AXI_GP0 [get_bd_intf_pins ps7_0/M_AXI_GP0] [get_bd_intf_pins ctrl/S00_AXI]
  connect_bd_intf_net -intf_net ps7_0_M_AXI_GP1 [get_bd_intf_pins ps7_0/M_AXI_GP1] [get_bd_intf_pins hctrl/S00_AXI]

  # Create port connections
  connect_bd_net -net audio_codec_ctrl_0_bclk  [get_bd_pins audio_codec_ctrl_0/bclk] \
  [get_bd_ports bclk]
  connect_bd_net -net audio_codec_ctrl_0_codec_address  [get_bd_pins audio_codec_ctrl_0/codec_address] \
  [get_bd_ports codec_addr]
  connect_bd_net -net audio_codec_ctrl_0_lrclk  [get_bd_pins audio_codec_ctrl_0/lrclk] \
  [get_bd_ports lrclk]
  connect_bd_net -net audio_codec_ctrl_0_sdata_o  [get_bd_pins audio_codec_ctrl_0/sdata_o] \
  [get_bd_ports sdata_o]
  connect_bd_net -net clk_wiz_10MHz_clk_out1  [get_bd_pins clk_wiz_10MHz/clk_out1] \
  [get_bd_ports audio_clk_10MHz]
  connect_bd_net -net hand_reset_and_Res  [get_bd_pins hand_reset_and/Res] \
  [get_bd_pins hand_i8/ap_rst_n]
  connect_bd_net -net hand_reset_gpio_io_o  [get_bd_pins hand_reset/gpio_io_o] \
  [get_bd_pins hand_reset_and/Op1]
  connect_bd_net -net one_dout  [get_bd_pins one/dout] \
  [get_bd_pins rst100/dcm_locked] \
  [get_bd_pins rst100hand/dcm_locked]
  connect_bd_net -net ps7_0_FCLK_CLK0  [get_bd_pins ps7_0/FCLK_CLK0] \
  [get_bd_pins rst100/slowest_sync_clk] \
  [get_bd_pins ps7_0/M_AXI_GP0_ACLK] \
  [get_bd_pins ctrl/ACLK] \
  [get_bd_pins ctrl/S00_ACLK] \
  [get_bd_pins ctrl/M00_ACLK] \
  [get_bd_pins audio_codec_ctrl_0/s_axi_aclk] \
  [get_bd_pins clk_wiz_10MHz/clk_in1] \
  [get_bd_pins ps7_0/S_AXI_GP0_ACLK]
  connect_bd_net -net ps7_0_FCLK_CLK3  [get_bd_pins ps7_0/FCLK_CLK3] \
  [get_bd_pins rst100hand/slowest_sync_clk] \
  [get_bd_pins hand_i8/ap_clk] \
  [get_bd_pins hctrl/ACLK] \
  [get_bd_pins hctrl/S00_ACLK] \
  [get_bd_pins hctrl/M00_ACLK] \
  [get_bd_pins hctrl/M01_ACLK] \
  [get_bd_pins hand_reset/s_axi_aclk] \
  [get_bd_pins mem/ACLK] \
  [get_bd_pins mem/S00_ACLK] \
  [get_bd_pins mem/M00_ACLK] \
  [get_bd_pins ps7_0/S_AXI_HP1_ACLK] \
  [get_bd_pins ps7_0/M_AXI_GP1_ACLK] \
  [get_bd_pins ps7_0/S_AXI_HP0_ACLK] \
  [get_bd_pins ps7_0/S_AXI_HP2_ACLK]
  connect_bd_net -net ps7_0_FCLK_RESET0_N  [get_bd_pins ps7_0/FCLK_RESET0_N] \
  [get_bd_pins rst100/ext_reset_in] \
  [get_bd_pins rst100hand/ext_reset_in]
  connect_bd_net -net rst100_peripheral_aresetn  [get_bd_pins rst100/peripheral_aresetn] \
  [get_bd_pins ctrl/ARESETN] \
  [get_bd_pins ctrl/S00_ARESETN] \
  [get_bd_pins ctrl/M00_ARESETN] \
  [get_bd_pins audio_codec_ctrl_0/s_axi_aresetn] \
  [get_bd_pins clk_wiz_10MHz/resetn]
  connect_bd_net -net rst100hand_peripheral_aresetn  [get_bd_pins rst100hand/peripheral_aresetn] \
  [get_bd_pins hctrl/ARESETN] \
  [get_bd_pins hctrl/S00_ARESETN] \
  [get_bd_pins hctrl/M00_ARESETN] \
  [get_bd_pins hctrl/M01_ARESETN] \
  [get_bd_pins hand_reset/s_axi_aresetn] \
  [get_bd_pins mem/ARESETN] \
  [get_bd_pins mem/S00_ARESETN] \
  [get_bd_pins mem/M00_ARESETN] \
  [get_bd_pins hand_reset_and/Op2]
  connect_bd_net -net sdata_i_1  [get_bd_ports sdata_i] \
  [get_bd_pins audio_codec_ctrl_0/sdata_i]

  # Create address segments
  assign_bd_address -offset 0x43C00000 -range 0x00010000 -target_address_space [get_bd_addr_spaces ps7_0/Data] [get_bd_addr_segs audio_codec_ctrl_0/S_AXI/reg0] -force
  assign_bd_address -offset 0x80000000 -range 0x00010000 -target_address_space [get_bd_addr_spaces ps7_0/Data] [get_bd_addr_segs hand_i8/s_axi_control/Reg] -force
  assign_bd_address -offset 0x80010000 -range 0x00010000 -target_address_space [get_bd_addr_spaces ps7_0/Data] [get_bd_addr_segs hand_reset/S_AXI/Reg] -force
  assign_bd_address -offset 0x00000000 -range 0x20000000 -target_address_space [get_bd_addr_spaces hand_i8/Data_m_axi_gmem] [get_bd_addr_segs ps7_0/S_AXI_HP1/HP1_DDR_LOWOCM] -force


  # Restore current instance
  current_bd_instance $oldCurInst

  validate_bd_design
  save_bd_design
}
# End of create_root_design()



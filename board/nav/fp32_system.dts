	chosen {
		bootargs = "console=ttyPS0,115200 cma=128M earlycon root=/dev/mmcblk0p2 rw rootwait";
		stdout-path = "serial0:115200n8";
	};

	aliases {
		ethernet0 = "/amba/ethernet@e000b000";
		ethernet1 = "/amba/ethernet@e000c000";
		i2c0 = "/amba_pl/i2c@41600000";
		i2c1 = "/amba/i2c@e0004000";
		i2c2 = "/amba/i2c@e0005000";
		serial0 = "/amba/serial@e0000000";
		serial1 = "/amba/serial@e0001000";
		spi0 = "/amba/spi@e000d000";
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x40000000>;
	};

	leds {
		compatible = "gpio-leds";

		gpio-led1 {
			label = "led1";
			gpios = <0x09 0x36 0x00>;
			default-state = "on";
		};

		gpio-led2 {
			label = "led2";
			gpios = <0x09 0x00 0x00>;
			linux,default-trigger = "heartbeat";
		};

		gpio-led3 {
			label = "pl_led0";
			gpios = <0x2e 0x00 0x00 0x00>;
			default-state = "on";
		};

		gpio-led4 {
			label = "pl_led1";
			gpios = <0x2e 0x01 0x00 0x00>;
			linux,default-trigger = "timer";
		};

		gpio-led5 {
			label = "ps_led0";
			gpios = <0x09 0x07 0x00>;
			default-state = "on";
		};

		gpio-led6 {
			label = "ps_led1";
			gpios = <0x09 0x08 0x00>;
			linux,default-trigger = "timer";
		};
	};

	keys {
		compatible = "gpio-keys";
		autorepeat;

		gpio-key1 {
			label = "pl_key0";
			gpios = <0x09 0x37 0x01>;
			linux,code = <0x69>;
			gpio-key,wakeup;
			autorepeat;
		};

		gpio-key2 {
			label = "pl_key1";
			gpios = <0x09 0x38 0x01>;
			linux,code = <0x6a>;
			gpio-key,wakeup;
			autorepeat;
		};

		gpio-key3 {
			label = "ps_key1";
			gpios = <0x09 0x0c 0x01>;
			linux,code = <0x67>;
			gpio-key,wakeup;
			autorepeat;
		};

		gpio-key4 {
			label = "ps_key2";
			gpios = <0x09 0x0b 0x01>;
			linux,code = <0x6c>;
			gpio-key,wakeup;
			autorepeat;
		};

		touch-key {
			label = "touch_key";
			gpios = <0x09 0x39 0x00>;
			linux,code = <0x1c>;
			gpio-key,wakeup;
			autorepeat;
		};
	};

	beep {
		compatible = "gpio-beeper";
		gpios = <0x09 0x3a 0x00>;
	};

	phy0@e0002000 {
		compatible = "ulpi-phy";
		#phy-cells = <0x00>;
		reg = <0xe0002000 0x1000>;
		view-port = <0x170>;
		drv-vbus;
		phandle = <0x0d>;
	};

	__symbols__ {
		cpu0 = "/cpus/cpu@0";
		cpu1 = "/cpus/cpu@1";
		fpga_full = "/fpga-full";
		regulator_vccpint = "/fixedregulator";
		replicator_out_port0 = "/replicator/out-ports/port@0/endpoint";
		replicator_out_port1 = "/replicator/out-ports/port@1/endpoint";
		replicator_in_port0 = "/replicator/in-ports/port/endpoint";
		amba = "/amba";
		adc = "/amba/adc@f8007100";
		can0 = "/amba/can@e0008000";
		can1 = "/amba/can@e0009000";
		gpio0 = "/amba/gpio@e000a000";
		i2c0 = "/amba/i2c@e0004000";
		codec = "/amba/i2c@e0004000/wm8960@1a";
		i2c1 = "/amba/i2c@e0005000";
		intc = "/amba/interrupt-controller@f8f01000";
		L2 = "/amba/cache-controller@f8f02000";
		mc = "/amba/memory-controller@f8006000";
		ocmc = "/amba/ocmc@f800c000";
		uart0 = "/amba/serial@e0000000";
		uart1 = "/amba/serial@e0001000";
		spi0 = "/amba/spi@e0006000";
		spi1 = "/amba/spi@e0007000";
		qspi = "/amba/spi@e000d000";
		smcc = "/amba/memory-controller@e000e000";
		nand0 = "/amba/memory-controller@e000e000/flash@e1000000";
		nor0 = "/amba/memory-controller@e000e000/flash@e2000000";
		gem0 = "/amba/ethernet@e000b000";
		ethernet_phy = "/amba/ethernet@e000b000/ethernet-phy@7";
		gem1 = "/amba/ethernet@e000c000";
		pl_phy = "/amba/ethernet@e000c000/pl_phy@4";
		sdhci0 = "/amba/mmc@e0100000";
		sdhci1 = "/amba/mmc@e0101000";
		slcr = "/amba/slcr@f8000000";
		clkc = "/amba/slcr@f8000000/clkc@100";
		rstc = "/amba/slcr@f8000000/rstc@200";
		pinctrl0 = "/amba/slcr@f8000000/pinctrl@700";
		dmac_s = "/amba/dmac@f8003000";
		devcfg = "/amba/devcfg@f8007000";
		efuse = "/amba/efuse@f800d000";
		global_timer = "/amba/timer@f8f00200";
		ttc0 = "/amba/timer@f8001000";
		ttc1 = "/amba/timer@f8002000";
		scutimer = "/amba/timer@f8f00600";
		usb0 = "/amba/usb@e0002000";
		usb1 = "/amba/usb@e0003000";
		watchdog0 = "/amba/watchdog@f8005000";
		etb_in_port = "/amba/etb@f8801000/in-ports/port/endpoint";
		tpiu_in_port = "/amba/tpiu@f8803000/in-ports/port/endpoint";
		funnel_out_port = "/amba/funnel@f8804000/out-ports/port/endpoint";
		funnel0_in_port0 = "/amba/funnel@f8804000/in-ports/port@0/endpoint";
		funnel0_in_port1 = "/amba/funnel@f8804000/in-ports/port@1/endpoint";
		funnel0_in_port2 = "/amba/funnel@f8804000/in-ports/port@2/endpoint";
		ptm0_out_port = "/amba/ptm@f889c000/out-ports/port/endpoint";
		ptm1_out_port = "/amba/ptm@f889d000/out-ports/port/endpoint";
		amba_pl = "/amba_pl";
		audio_audio_formatter = "/amba_pl/audio_formatter@43c50000";
		misc_clk_0 = "/amba_pl/misc_clk_0";
		audio_i2s_receiver = "/amba_pl/i2s_receiver@43c60000";
		audio_i2s_transmitter = "/amba_pl/i2s_transmitter@43c70000";
		axi_gpio_0 = "/amba_pl/gpio@41210000";
		camera_in_v_frmbuf_wr_0 = "/amba_pl/v_frmbuf_wr@43c40000";
		clk_wiz_0 = "/amba_pl/clk_wiz@43c30000";
		hdmi_out_clk_wiz_dyn = "/amba_pl/clk_wiz@43c80000";
		hdmi_out_hdmi_vtc = "/amba_pl/v_tc@43c90000";
		misc_clk_1 = "/amba_pl/misc_clk_1";
		hdmi_out_v_frmbuf_rd_0 = "/amba_pl/v_frmbuf_rd@43ca0000";
		i2c2 = "/amba_pl/i2c@41600000";
		ov5640_ep = "/amba_pl/i2c@41600000/ov5640@3c/port@0/endpoint";
		lcd_out_lcd_id = "/amba_pl/gpio@41200000";
		lcd_out_lcd_pl_pwm = "/amba_pl/PWM@43c00000";
		lcd_out_lcd_vtc = "/amba_pl/v_tc@43c10000";
		misc_clk_2 = "/amba_pl/misc_clk_2";
		lcd_out_v_frmbuf_rd_0 = "/amba_pl/v_frmbuf_rd@43c20000";
		rest_gpio = "/amba_pl/gpio@41220000";
		pl_disp_crtc_lcd = "/amba_pl/drm_pl_disp_lcd/ports/port@0/endpoint";
		lcd_encoder = "/amba_pl/atk_lcd_drm/ports/port@0/endpoint";
		timing_4342 = "/amba_pl/atk_lcd_drm/display-timings/timing0";
		timing_7084 = "/amba_pl/atk_lcd_drm/display-timings/timing1";
		timing_7016 = "/amba_pl/atk_lcd_drm/display-timings/timing2";
		timing_1018 = "/amba_pl/atk_lcd_drm/display-timings/timing3";
		pl_disp_crtc_hdmi = "/amba_pl/drm_pl_disp_hdmi/ports/port@0/endpoint";
		hdmi_encoder = "/amba_pl/atk_hdmi_drm/ports/port@0/endpoint";
		xlnx_vcap = "/amba_pl/vcap_dvp/ports/port@0/endpoint";
		usb_phy0 = "/phy0@e0002000";
	};
};

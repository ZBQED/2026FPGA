        <PORT DIR="O" LEFT="1" NAME="s_axi_bresp" RIGHT="0" SIGIS="undef" SIGNAME="cnn_gp1_ctrl_M02_AXI_bresp">
          <CONNECTIONS>
            <CONNECTION INSTANCE="cnn_gp1_ctrl" PORT="M02_AXI_bresp"/>
          </CONNECTIONS>
        </PORT>

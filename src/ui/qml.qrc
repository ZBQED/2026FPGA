        <file alias="qml/PreviewWindow.qml">qml/previewwindow.qml</file>
        <file alias="qml/StaffWindow.qml">qml/staffwindow.qml</file>
        <file alias="qml/PatientWindow.qml">qml/patientwindow.qml</file>
        <file alias="qml/StaffPanel.qml">qml/staffpanel.qml</file>
        <file alias="qml/PatientPanel.qml">qml/patientpanel.qml</file>
        <file alias="qml/StatusPill.qml">qml/statuspill.qml</file>
    </qresource>
</RCC>
